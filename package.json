{
  "name": "simplereader",
  "version": "2.3.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "Browser-based TXT/EPUB reader (Vite-powered refactored edition)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p jsconfig.checked.json",
    "preprocess-books": "node build-tools/preprocess-books.mjs",
    "postinstall": "node build-tools/fetch-opencc-bundle.mjs",
    "test": "node test/run-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node test/run-tests.mjs --browser",
    "validate": "sh build-tools/validate.sh",
    "test:extension": "node test/extension-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/jquery": "^3.5.31",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^15",
    "jschardet": "^3.1.4",
    "jszip": "3.10.1",
    "linkedom": "^0.18.12",
    "opencc-js": "^1.3.2",
    "playwright-core": "1.57.0",
    "prettier": "^3",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
