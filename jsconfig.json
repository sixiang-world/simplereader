{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {},
    "typeRoots": ["./node_modules/@types"],
    "types": ["jquery"]
  },
  "include": [
    "client/**/*.js",
    "shared/**/*.js",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "archive",
    "build-tools",
    "client/lib/**"
  ]
}
